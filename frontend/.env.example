# Frontend Environment Variables (Vite)
# Prefix with VITE_ to expose to client

# Marketing site URL for landing page CTAs
VITE_MARKETING_URL=https://omni-migrate-company.vercel.app

# Analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Error tracking
VITE_SENTRY_DSN=

# App environment
VITE_APP_ENV=development
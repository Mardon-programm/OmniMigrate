# Production Environment Variables
# Copy to backend/.env.prod and fill in all values

# --- Core ---
APP_NAME=OmniMigrate
DEBUG=false
ENVIRONMENT=production

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-64-char-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=["https://your-vercel-app.vercel.app","https://yourdomain.com"]

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Database (Render/Neon/Supabase managed PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/omnimigrate

# Redis (Upstash/Redis Cloud/Render Redis)
REDIS_URL=redis://host:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM (Gemini on Google AI Studio)
OPENAI_API_KEY=your-gemini-api-key
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=65536
LLM_FALLBACK_TO_RULES=true

# Anti-shrinkage output contract (do not disable in production)
CONTRACT_ENABLED=true
CONTRACT_MIN_LINE_RATIO=0.75
CONTRACT_EXTRA_IMPORTS=[]

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
MAX_SELF_HEAL_ATTEMPTS=3

# Git / GitHub
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BASE_BRANCH=main
GIT_AUTHOR_NAME=OmniMigrate Bot
GIT_AUTHOR_EMAIL=bot@yourdomain.com
GIT_BRANCH_PREFIX=omnimigrate
GIT_CLONE_TIMEOUT_SECONDS=120
GIT_TEST_TIMEOUT_SECONDS=600
GIT_MAX_REPO_BYTES=209715200

# Storage
WORKSPACE_ROOT=/data/workspaces

# SMTP / Email (Resend/SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your-resend-api-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=OmniMigrate
SMTP_USE_TLS=true

# Paddle Billing (Live keys)
PADDLE_API_KEY=live_...
PADDLE_VENDOR_ID=...
PADDLE_WEBHOOK_SECRET=live_...
PADDLE_PRICE_STARTER_MONTHLY=pri_...
PADDLE_PRICE_PRO_MONTHLY=pri_...
PADDLE_PRICE_PACK_10=pri_...
PADDLE_PRICE_PACK_50=pri_...
PADDLE_PRICE_PACK_100=pri_...
PADDLE_PRICE_PACK_500=pri_...
PADDLE_PRICE_PACK_1000=pri_...

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=secure-admin-password

# Monitoring
SENTRY_DSN=
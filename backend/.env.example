# --- Core ---
APP_NAME=OmniMigrate
DEBUG=false
ENVIRONMENT=production

# --- Security ---
# IMPORTANT: generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=["https://your-vercel-app.vercel.app","https://yourdomain.com"]

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# Use Render/Neon/Supabase managed PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/omnimigrate

# --- Redis ---
# Use Upstash/Redis Cloud/Render Redis
REDIS_URL=redis://host:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LLM (Gemini on Google AI Studio) ---
OPENAI_API_KEY=your-gemini-api-key
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=65536
LLM_FALLBACK_TO_RULES=true

# --- Anti-shrinkage output contract ---
CONTRACT_ENABLED=true
# Minimum ratio of non-blank, non-import code lines vs. the source (0.0-1.0).
CONTRACT_MIN_LINE_RATIO=0.75
# Comma/JSON list of extra import roots allowed in generated code.
CONTRACT_EXTRA_IMPORTS=[]

# --- Sandbox ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
MAX_SELF_HEAL_ATTEMPTS=3

# --- Git / GitHub ---
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BASE_BRANCH=main
GIT_AUTHOR_NAME=OmniMigrate Bot
GIT_AUTHOR_EMAIL=bot@omnimigrate.app
GIT_BRANCH_PREFIX=omnimigrate
GIT_CLONE_TIMEOUT_SECONDS=120
GIT_TEST_TIMEOUT_SECONDS=600
GIT_MAX_REPO_BYTES=209715200

# --- Storage ---
WORKSPACE_ROOT=/data/workspaces

# --- SMTP / Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@omnimigrate.app
SMTP_FROM_NAME=OmniMigrate
SMTP_USE_TLS=true

# --- Paddle / Billing ---
PADDLE_API_KEY=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=

# --- Admin ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

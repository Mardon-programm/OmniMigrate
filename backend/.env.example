# --- Core ---
APP_NAME=OmniMigrate
DEBUG=false
ENVIRONMENT=development

# --- Security ---
# IMPORTANT: generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
DATABASE_URL=postgresql+asyncpg://omnimigrate:omnimigrate@postgres:5432/omnimigrate

# --- Redis ---
REDIS_URL=redis://redis:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- OpenAI / LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_FALLBACK_TO_RULES=true

# --- Sandbox ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=30
MAX_SELF_HEAL_ATTEMPTS=3

# --- Git / GitHub ---
GITHUB_API_URL=https://api.github.com
GITHUB_DEFAULT_BASE_BRANCH=main
GIT_AUTHOR_NAME=OmniMigrate Bot
GIT_AUTHOR_EMAIL=bot@omnimigrate.app
GIT_BRANCH_PREFIX=omnimigrate
GIT_CLONE_TIMEOUT_SECONDS=120
GIT_TEST_TIMEOUT_SECONDS=600
GIT_MAX_REPO_BYTES=209715200

# --- Storage ---
WORKSPACE_ROOT=/data/workspaces

# --- SMTP / Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@omnimigrate.app
SMTP_FROM_NAME=OmniMigrate
SMTP_USE_TLS=true

# --- Paddle / Billing ---
PADDLE_API_KEY=
PADDLE_VENDOR_ID=
PADDLE_WEBHOOK_SECRET=

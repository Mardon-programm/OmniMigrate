# Caddyfile - Automatic HTTPS reverse proxy
# Place at /etc/caddy/Caddyfile on your server.
# Caddy is the only process bound to 80/443; frontend is exposed on the
# internal Docker network only.

yourdomain.com {
	encode zstd gzip

	# Health check handled by Caddy itself.
	@health path /healthz
	handle @health {
		respond "OK" 200
	}

	# Frontend (nginx container) on the internal network.
	handle {
		reverse_proxy frontend:80
	}
}

api.yourdomain.com {
	encode zstd gzip

	@health path /healthz
	handle @health {
		reverse_proxy backend:8003
	}

	handle {
		reverse_proxy backend:8003 {
			header_up Host {http.reverse_proxy.upstream.hostport}
		}
	}
}

# Redirect www to non-www.
www.yourdomain.com {
	redir https://yourdomain.com{uri} permanent
}
